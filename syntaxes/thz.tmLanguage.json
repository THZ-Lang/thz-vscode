{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "THZ-LANG",
  "scopeName": "source.thz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#cobol-embedded" },
    { "include": "#named-declarations" },
    { "include": "#typed-properties" },
    { "include": "#inferred-assignments" },
    { "include": "#contracts" },
    { "include": "#pipeline-blocks" },
    { "include": "#declarations" },
    { "include": "#control-flow" },
    { "include": "#memory-simd" },
    { "include": "#metadata-keys" },
    { "include": "#types" },
    { "include": "#stdlib" },
    { "include": "#constants" },
    { "include": "#logical-operators" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.thz",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.thz",
          "match": "//.*$"
        },
        {
          "name": "comment.block.thz",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.thz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.thz",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.thz",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.thz",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.thz",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.thz",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "named-declarations": {
      "patterns": [
        {
          "match": "(?i)\\b(programa\\s+(?:negocio|visual|arquitetura)?|programa|biblioteca|extensao|ferramenta|teste|tela|pipeline_dados)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.thz" },
            "2": { "name": "entity.name.type.module.thz" }
          }
        },
        {
          "match": "(?i)\\b(estrutura|enumeracao|struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.thz" },
            "2": { "name": "entity.name.type.class.thz" }
          }
        },
        {
          "match": "(?i)\\b(regra_negocio|regra|procedimento|funcao|operacao|transformacao|rule|fn|proc|func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.thz" },
            "2": { "name": "entity.name.function.thz" }
          }
        },
        {
          "match": "(?i)\\b(fonte_entrada|destino_saida)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.thz" },
            "2": { "name": "entity.name.type.class.thz" }
          }
        },
        {
          "match": "(?i)\\b(variavel|var|let|const|val)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.variable.thz" },
            "2": { "name": "variable.other.declaration.thz" }
          }
        },
        {
          "match": "(?i)\\b(criar|new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.new.thz" },
            "2": { "name": "entity.name.type.class.thz" }
          }
        }
      ]
    },
    "typed-properties": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?!:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.property.thz" },
            "2": { "name": "punctuation.separator.thz" },
            "3": { "name": "entity.name.type.thz" }
          }
        }
      ]
    },
    "inferred-assignments": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:=)",
          "captures": {
            "1": { "name": "variable.other.assignment.thz" },
            "2": { "name": "keyword.operator.assignment.thz" }
          }
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "keyword.control.contract.thz",
          "match": "(?i)\\b(contrato_entrada|fim_contrato_entrada|contrato_saida|fim_contrato_saida|exige|garante|invariante|chave_idempotencia|require|ensure|invariant)\\b"
        }
      ]
    },
    "pipeline-blocks": {
      "patterns": [
        {
          "name": "keyword.control.pipeline.thz",
          "match": "(?i)\\b(pipeline_dados|fim_pipeline|fonte_entrada|fim_fonte|destino_saida|fim_destino|transformacao|fim_transformacao)\\b"
        },
        {
          "name": "support.constant.pipeline.thz",
          "match": "(?i)\\b(streaming|lote|conector|formato|colecao)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.control.declaration.thz",
          "match": "(?i)\\b(programa|visual|negocio|arquitetura|biblioteca|extensao|ferramenta|teste|tela|fim_programa|fim_biblioteca|fim_extensao|fim_ferramenta|fim_teste|fim_tela|metadados_arquitetura|fim_metadados|metadados|estrutura|fim_estrutura|struct|enumeracao|fim_enumeracao|enum|regra_negocio|fim_regra_negocio|regra|rule|procedimento|proc|funcao|fim_funcao|fn|func|operacao|fim_operacao|op|variavel|var|val|let|const|importar|versao_linguagem|criar|new|idempotente|bloco_cobol|fim_bloco_cobol|importar_copybook)\\b"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.thz",
          "match": "(?i)\\b(inicio|fim|se|entao|senao|fim_se|enquanto|faca|fim_enquanto|para|de|ate|passo|fim_para|retorne|retornar|return|falhar_com|exiba|print|ler|caso_resultado|escolha|caso|match|case|fim_caso|fim_escolha|sucesso|erro|falha|tente|capture|fim_tente|try|catch|if|else|while|for)\\b"
        }
      ]
    },
    "memory-simd": {
      "patterns": [
        {
          "name": "keyword.control.memory.thz",
          "match": "(?i)\\b(usar_bloco_memoria|fim_bloco_memoria|vetorizar_para|fim_vetorizar|layout_colunar|em|passo_simd|arena_ephemeral)\\b"
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.class.thz",
          "match": "(?i)\\b(texto|matematica|data|tela|gui|console|thzio|thzconfig|thzsecurity|thzlog|thzhttpserver|documento|thzuimaker|cobol)\\b"
        },
        {
          "name": "support.function.thz",
          "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    "metadata-keys": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.thz",
          "match": "(?i)\\b(sistema|modulo|dominio|subdominio|camada|versao|autor|responsavel|slo_latencia_ms|slo_latencia_maxima|conformidade|criticidade|identificador_regra|rastreio_requisito|descricao|tipo|colecao|conector|formato)(?=\\s*:)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.thz",
          "match": "(?i)\\b(texto|logico|uuid|data|data_hora|natural8|natural16|natural32|natural64|inteiro|inteiro8|inteiro16|inteiro32|inteiro64|decimal|monetario|fatia|resultado|lista|bool|boolean|string|int|float|void)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.thz",
          "match": "(?i)\\b(verdadeiro|falso|nulo|true|false|null)\\b"
        }
      ]
    },
    "logical-operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.thz",
          "match": "(?i)\\b(e|ou|nao|and|or|not)\\b|&&|\\|\\||!"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.thz",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.assignment.thz",
          "match": "(:=|<-|=)"
        },
        {
          "name": "keyword.operator.comparison.thz",
          "match": "(<=|>=|<>|==|!=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.thz",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.thz",
          "match": "(:|,|;)"
        },
        {
          "name": "punctuation.bracket.thz",
          "match": "(\\(|\\)|\\[|\\]|\\{|\\})"
        }
      ]
    },
    "cobol-embedded": {
      "begin": "(?i)^\\s*(BLOCO_COBOL)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.declaration.cobol.thz" }
      },
      "end": "(?i)^\\s*(FIM_BLOCO_COBOL)\\b",
      "endCaptures": {
        "1": { "name": "keyword.control.declaration.cobol.thz" }
      },
      "patterns": [
        { "include": "source.cobol" },
        { "include": "#cobol-internal-grammar" }
      ]
    },
    "cobol-internal-grammar": {
      "patterns": [
        {
          "name": "comment.line.cobol",
          "match": "^\\s*(\\*[^\r\n]*|#.*$|//.*$)"
        },
        {
          "name": "string.quoted.double.cobol",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.cobol", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.cobol",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.cobol", "match": "\\\\." }]
        },
        {
          "name": "keyword.control.division.cobol",
          "match": "(?i)\\b(IDENTIFICATION|ENVIRONMENT|DATA|PROCEDURE)\\s+DIVISION\\b"
        },
        {
          "name": "keyword.control.section.cobol",
          "match": "(?i)\\b(WORKING-STORAGE|LINKAGE|FILE|LOCAL-STORAGE|SCREEN|CONFIGURATION|INPUT-OUTPUT)\\s+SECTION\\b"
        },
        {
          "match": "(?i)\\b(PROGRAM-ID|AUTHOR|INSTALLATION|DATE-WRITTEN|DATE-COMPILED)\\s*\\.\\s*([A-Za-z0-9_-]+)?",
          "captures": {
            "1": { "name": "keyword.control.cobol" },
            "2": { "name": "entity.name.function.cobol" }
          }
        },
        {
          "name": "keyword.control.cobol",
          "match": "(?i)\\b(MOVE|TO|PERFORM|THRU|THROUGH|VARYING|FROM|UNTIL|BY|COMPUTE|ADD|SUBTRACT|MULTIPLY|DIVIDE|IF|THEN|ELSE|END-IF|END-PERFORM|END-COMPUTE|END-EVALUATE|END-READ|END-WRITE|GOBACK|STOP\\s+RUN|DISPLAY|ACCEPT|CALL|USING|EXIT|STOP|INITIALIZE|STRING|UNSTRING|OPEN|CLOSE|READ|WRITE|REWRITE|DELETE|INSPECT|SEARCH|WHEN|EVALUATE)\\b"
        },
        {
          "name": "variable.other.level.cobol",
          "match": "\\b(0[1-9]|[1-4][0-9]|50|66|77|88)\\b"
        },
        {
          "match": "(?i)\\b(PIC(?:TURE)?(?:\\s+IS)?)\\s+([A-Za-z0-9()VvSs$.,-]+)",
          "captures": {
            "1": { "name": "keyword.type.cobol" },
            "2": { "name": "storage.type.cobol" }
          }
        },
        {
          "name": "storage.modifier.cobol",
          "match": "(?i)\\b(COMP|COMP-1|COMP-2|COMP-3|COMP-4|COMP-5|COMPUTATIONAL(?:-[1-5])?|BINARY|PACKED-DECIMAL|DISPLAY|INDEX|POINTER)\\b"
        },
        {
          "name": "keyword.other.cobol",
          "match": "(?i)\\b(VALUE(?:S)?(?:\\s+(?:IS|ARE))?|OCCURS|TIMES|INDEXED\\s+BY|REDEFINES|RENAMES|JUSTIFIED|SYNCHRONIZED|BLANK\\s+WHEN\\s+ZERO)\\b"
        },
        {
          "name": "constant.language.cobol",
          "match": "(?i)\\b(SPACES?|ZEROS?|ZEROES?|HIGH-VALUES?|LOW-VALUES?|QUOTES?|NULLS?)\\b"
        },
        {
          "name": "constant.numeric.decimal.cobol",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.cobol",
          "match": "\\b\\d[\\d_]*\\b"
        },
        {
          "name": "keyword.operator.cobol",
          "match": "(\\+|-|\\*|/|\\*\\*|=|<|>|<=|>=|<>|(?i)\\b(NOT|AND|OR)\\b)"
        },
        {
          "name": "punctuation.separator.cobol",
          "match": "(\\.|,|;)"
        }
      ]
    }
  }
}
