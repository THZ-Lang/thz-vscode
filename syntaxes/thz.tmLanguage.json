{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "THZ-LANG",
  "scopeName": "source.thz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#named-declarations" },
    { "include": "#contracts" },
    { "include": "#pipeline-blocks" },
    { "include": "#declarations" },
    { "include": "#control-flow" },
    { "include": "#memory-simd" },
    { "include": "#metadata-keys" },
    { "include": "#types" },
    { "include": "#stdlib" },
    { "include": "#constants" },
    { "include": "#logical-operators" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.thz",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.thz",
          "match": "//.*$"
        },
        {
          "name": "comment.block.thz",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.thz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.thz",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.thz",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.thz",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "named-declarations": {
      "patterns": [
        {
          "match": "\\b(PROGRAMA\\s+(?:NEGOCIO|VISUAL|ARQUITETURA)?|PROGRAMA|BIBLIOTECA|EXTENSAO|FERRAMENTA|TESTE|TELA|PIPELINE_DADOS|programa\\s+(?:NEGOCIO|VISUAL|ARQUITETURA)?|biblioteca|ferramenta|teste|tela)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.thz" },
            "2": { "name": "entity.name.type.module.thz" }
          }
        },
        {
          "match": "\\b(ESTRUTURA|ENUMERACAO|estrutura|enumeracao)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.thz" },
            "2": { "name": "entity.name.type.class.thz" }
          }
        },
        {
          "match": "\\b(REGRA_NEGOCIO|PROCEDIMENTO|FUNCAO|OPERACAO|TRANSFORMACAO|regra|procedimento|funcao|operacao)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.thz" },
            "2": { "name": "entity.name.function.thz" }
          }
        },
        {
          "match": "\\b(FONTE_ENTRADA|DESTINO_SAIDA)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.thz" },
            "2": { "name": "entity.name.type.class.thz" }
          }
        },
        {
          "match": "\\b(VARIAVEL)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.variable.thz" },
            "2": { "name": "variable.other.declaration.thz" }
          }
        },
        {
          "match": "\\b(CRIAR)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.new.thz" },
            "2": { "name": "entity.name.type.class.thz" }
          }
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "keyword.control.contract.thz",
          "match": "\\b(CONTRATO_ENTRADA|FIM_CONTRATO_ENTRADA|CONTRATO_SAIDA|FIM_CONTRATO_SAIDA|EXIGE|GARANTE|INVARIANTE|CHAVE_IDEMPOTENCIA)\\b"
        }
      ]
    },
    "pipeline-blocks": {
      "patterns": [
        {
          "name": "keyword.control.pipeline.thz",
          "match": "\\b(PIPELINE_DADOS|FIM_PIPELINE|FONTE_ENTRADA|FIM_FONTE|DESTINO_SAIDA|FIM_DESTINO|TRANSFORMACAO|FIM_TRANSFORMACAO)\\b"
        },
        {
          "name": "support.constant.pipeline.thz",
          "match": "\\b(STREAMING|LOTE|CONECTOR|FORMATO|COLECAO)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.control.declaration.thz",
          "match": "\\b(PROGRAMA|VISUAL|NEGOCIO|ARQUITETURA|BIBLIOTECA|EXTENSAO|FERRAMENTA|TESTE|TELA|FIM_PROGRAMA|FIM_BIBLIOTECA|FIM_EXTENSAO|FIM_FERRAMENTA|FIM_TESTE|FIM_TELA|METADADOS_ARQUITETURA|FIM_METADADOS|ESTRUTURA|FIM_ESTRUTURA|ENUMERACAO|FIM_ENUMERACAO|REGRA_NEGOCIO|FIM_REGRA_NEGOCIO|PROCEDIMENTO|FUNCAO|FIM_FUNCAO|OPERACAO|FIM_OPERACAO|VARIAVEL|IMPORTAR|VERSAO_LINGUAGEM|CRIAR|IDEMPOTENTE|programa|biblioteca|ferramenta|teste|tela|metadados|estrutura|enumeracao|regra|procedimento|funcao|operacao)\\b"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.thz",
          "match": "\\b(INICIO|FIM|SE|ENTAO|SENAO|FIM_SE|ENQUANTO|FACA|FIM_ENQUANTO|PARA|DE|ATE|PASSO|FIM_PARA|RETORNE|RETORNAR|FALHAR_COM|EXIBA|LER|CASO_RESULTADO|ESCOLHA|CASO|FIM_CASO|FIM_ESCOLHA|SUCESSO|ERRO|FALHA|TENTE|CAPTURE|FIM_TENTE|se|senao|enquanto|para|de|ate|passo|retorne|exiba|exige|garante|invariante)\\b"
        }
      ]
    },
    "memory-simd": {
      "patterns": [
        {
          "name": "keyword.control.memory.thz",
          "match": "\\b(USAR_BLOCO_MEMORIA|FIM_BLOCO_MEMORIA|VETORIZAR_PARA|FIM_VETORIZAR|LAYOUT_COLUNAR|EM|PASSO_SIMD|ARENA_EPHEMERAL)\\b"
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.class.thz",
          "match": "\\b(TEXTO|MATEMATICA|DATA|TELA|GUI|Console|ThzIO|ThzConfig|ThzSecurity|ThzLog|ThzHttpServer|DOCUMENTO|ThzUiMaker)\\b"
        },
        {
          "name": "support.function.thz",
          "match": "(?<=\\.)(comprimento|tamanho|maiusculas|minusculas|aparar|contem|subtexto|substituir|dividir|juntar|abs|min|max|potencia|raiz|arredondar|aleatorio|hoje|agora|criar|criarDataHora|adicionarDias|adicionarHoras|diferencaDias|ano|mes|dia|diaDaSemana|texto|renderizarFormulario|alerta|confirmar|pedirTexto|criarContainer|criarCard|adicionarMetrica|adicionarBotao|adicionarCampoTexto|adicionarCampoMoeda|exibir)\\b"
        }
      ]
    },
    "metadata-keys": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.thz",
          "match": "\\b(SISTEMA|MODULO|DOMINIO|SUBDOMINIO|CAMADA|VERSAO|AUTOR|RESPONSAVEL|SLO_LATENCIA_MS|SLO_LATENCIA_MAXIMA|CONFORMIDADE|CRITICIDADE|IDENTIFICADOR_REGRA|RASTREIO_REQUISITO|DESCRICAO|TIPO|COLECAO|CONECTOR|FORMATO)(?=\\s*:)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.thz",
          "match": "\\b(TEXTO|LOGICO|UUID|DATA|DATA_HORA|NATURAL8|NATURAL16|NATURAL32|NATURAL64|INTEIRO|INTEIRO8|INTEIRO16|INTEIRO32|INTEIRO64|DECIMAL|MONETARIO|FATIA|RESULTADO|LISTA)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.thz",
          "match": "\\b(VERDADEIRO|FALSO|NULO)\\b"
        }
      ]
    },
    "logical-operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.thz",
          "match": "\\b(E|OU|NAO)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.thz",
          "match": "<-"
        },
        {
          "name": "keyword.operator.comparison.thz",
          "match": "(<=|>=|<>|==|=|!=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.thz",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.thz",
          "match": "(:|,)"
        },
        {
          "name": "punctuation.bracket.thz",
          "match": "(\\(|\\)|\\[|\\])"
        }
      ]
    }
  }
}
