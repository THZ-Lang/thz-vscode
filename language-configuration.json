{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["'", "'"],
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:programa|biblioteca|extensao|pipeline_dados|ferramenta|teste|tela|metadados(?:_arquitetura)?|estrutura|enumeracao|regra(?:_negocio)?|funcao|função|operacao|op|procedimento|proc|fn|se|senao|senão|enquanto|para|tente|capture|escolha|caso|usar_bloco_memoria|vetorizar_para|bloco_cobol)\\b.*(?::)?\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:senao|senão|capture|else|catch|fim_bloco_cobol)\\b.*(?::)?\\s*(?:#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*:\\s*(?:#.*)?$",
      "action": { "indentAction": "Indent" }
    }
  ]
}
